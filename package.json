{
  "name": "coda-bandcamp-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "web:dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --dir src && npm run test:automation-build",
    "test:automation-build": "node --test tools/build-macos-automation.test.mjs tools/coda-dev-runner.test.mjs",
    "test:coverage": "vitest run --coverage --dir src",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "desktop:build:local": "node --env-file=.env ./node_modules/@tauri-apps/cli/tauri.js build",
    "desktop:build:automation": "node tools/build-macos-automation.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.29",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^27.4.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17"
  }
}
