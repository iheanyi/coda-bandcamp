# Last.fm desktop application credentials
CODA_LASTFM_API_KEY=
CODA_LASTFM_SHARED_SECRET=

# Set to 0 only when debugging the CSS-native View Transitions fallback.
VITE_CODA_MOTION_VIEW_TRANSITIONS=1

# Tauri updater signing credentials
TAURI_SIGNING_PRIVATE_KEY=/absolute/path/to/coda-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Use ad-hoc code signing for local macOS builds.
APPLE_SIGNING_IDENTITY=-
