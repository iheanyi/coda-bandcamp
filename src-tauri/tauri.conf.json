{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coda",
  "version": "0.2.0",
  "identifier": "com.coda.bandcamp",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://bandcamp.com https://*.bcbits.com; img-src 'self' data: https://bandcamp.com https://*.bcbits.com; media-src 'self' https://bandcamp.com https://*.bcbits.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "title": "Coda",
        "label": "main",
        "theme": "Dark",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 680,
        "decorations": true,
        "titleBarStyle": "Visible",
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#111315",
        "devtools": false
      },
      {
        "title": "Coda Mini Player",
        "label": "mini-player",
        "url": "index.html?view=mini-player",
        "theme": "Dark",
        "width": 368,
        "height": 240,
        "minWidth": 368,
        "minHeight": 240,
        "maxWidth": 368,
        "maxHeight": 240,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "focus": false,
        "visible": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#111315",
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A focused Bandcamp desktop player with a real queue.",
    "longDescription": "Coda connects to Bandcamp's official Subsonic beta and gives your collection a fast, focused desktop listening experience with a persistent queue.",
    "copyright": "Copyright © 2026 Coda Contributors",
    "publisher": "Coda Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBREI5QjA1OEQyQ0ZBRkUKUldUKytpeU5CWnZiZWhXaTIwTUdFVm14WDYrUHlPZFk2eENOQXlGbGZnNThxNGtaeHJhZExhUSsK",
      "endpoints": [
        "https://github.com/iheanyi/coda-bandcamp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
